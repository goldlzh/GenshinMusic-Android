<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 键位坐标与设备分辨率、方向和挖孔位置绑定，不能跨设备恢复。 -->
        <exclude domain="sharedpref" path="key_layouts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="key_layouts.xml" />
    </device-transfer>
</data-extraction-rules>
